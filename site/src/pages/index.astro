---
import Base from "../layouts/Base.astro";
import { chapterPath, chapterUrl, editionKey, loadCatalog } from "../lib/catalog";

const {
  manifest,
  chapters,
  translations,
  transliterations,
  reciters,
  coverage,
} = loadCatalog();
const firstScript = manifest.scripts[0];
const firstTranslation = translations.editions[0];
const firstChapter = chapters[1];
const firstChapterPath = chapterPath(firstTranslation, firstChapter.id);
const firstChapterReaderUrl = `${chapterUrl(firstChapter)}?s=${firstScript.id}`;
const unverified = [...translations.editions, ...transliterations.editions].filter(
  (edition) => edition.license.status !== "granted",
);
const profileNote = unverified.length
  ? `This build includes ${unverified.length} edition${unverified.length === 1 ? "" : "s"} whose redistribution status is recorded as ${unverified.map((edition) => edition.license.status).join(" and ")}.`
  : "This build contains editions with a recorded redistribution grant.";
const translationLanguages = manifest.translations.languages;
const totalReciters = reciters ? reciters.reciters.length : 0;
const joinJavaScript = `const [arabic, translated] = await Promise.all([
  fetch("/text/${firstScript.id}/chapters/${firstChapter.id}.json").then((r) => r.json()),
  fetch("${firstChapterPath}").then((r) => r.json()),
]);

const translatedById = new Map(translated.verses.map((verse) => [verse.id, verse]));
const rows = arabic.verses.map((verse) => ({
  id: verse.id,
  text: verse.text,
  translation: translatedById.get(verse.id)?.translation,
}));`;
const joinPython = `import httpx

base = "https://quran-json.risanb.com"
arabic = httpx.get(f"{base}/text/${firstScript.id}/chapters/${firstChapter.id}.json").json()
translated = httpx.get(f"{base}${firstChapterPath}").json()
by_id = {verse["id"]: verse for verse in translated["verses"]}
rows = [{**verse, "translation": by_id[verse["id"]]["translation"]}
        for verse in arabic["verses"]]`;
const mappedExample = `const covering = warsh.verses.filter((verse) =>
  verse.number_in_hafs.includes(255)
);`;
---

<Base
  title="quran-json — Quran data, clearly published"
  description={`A stable Quran JSON API with ${manifest.scripts.length} text scripts, ${translations.count} translations, and chapter-first endpoints.`}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">A small, readable Quran data service</p>
      <h1>Read the text. Use the data.</h1>
      <p>
        Stable JSON paths for scripts, translations, transliteration layers, and recitations.
        Start with the reader or fetch one chapter in a single request.
      </p>
      <span class="hero-arabic" lang="ar" dir="rtl">ٱلْقُرْآن</span>
      <div class="actions">
        <a class="button-link primary" href="/app/">Open the reader <span aria-hidden="true">↗</span></a>
        <a class="button-link" href="#quickstart">Use one chapter <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <aside class="hero-note" aria-label="Published profile">
      <strong>{profileNote}</strong>
      <span>Counts and catalogue rows below come from this generated build profile.</span>
    </aside>
  </section>

  <div class="stats" aria-label="Published counts">
    <div class="stat"><strong>{manifest.scripts.length}</strong><span>scripts</span></div>
    <div class="stat"><strong>{translations.count}</strong><span>translations</span></div>
    <div class="stat"><strong>{translationLanguages}</strong><span>languages</span></div>
    <div class="stat"><strong>{transliterations.count}</strong><span>transliteration</span></div>
    <div class="stat"><strong>{manifest.chapters.count}</strong><span>chapters</span></div>
    <div class="stat"><strong>{totalReciters}</strong><span>reciters</span></div>
  </div>

  <section id="quickstart" class="section">
    <div class="section-heading">
      <h2>Start with a chapter</h2>
      <p>
        Chapter files are small enough for a reader and complete enough for a useful API call.
        Verse identity lives in <code>id</code>; mapped readings carry their explicit Hafs join.
      </p>
    </div>
    <div class="task-grid">
      <article class="task">
        <span class="number">01 · READ</span>
        <h3>Open a chapter</h3>
        <p>Use the reader for script, font, translation, and recitation choices.</p>
        <a href={firstChapterReaderUrl}>Read {firstChapter.transliteration} ↗</a>
      </article>
      <article class="task">
        <span class="number">02 · FETCH</span>
        <h3>Fetch one chapter</h3>
        <p>Use a plain GET. The Arabic and translation files keep their own verse identity.</p>
        <a href={`/text/${firstScript.id}/chapters/${firstChapter.id}.json`}>Fetch Arabic JSON ↗</a>
      </article>
      <article class="task">
        <span class="number">03 · BROWSE</span>
        <h3>Choose an edition</h3>
        <p>Browse generated catalogues with source, direction, version, and licence status.</p>
        <a href="#catalogues">Browse catalogues ↓</a>
      </article>
    </div>

    <div class="sample-block">
      <span class="sample-label">Join by verse identity</span>
      <pre><code>{joinJavaScript}</code></pre>
    </div>
    <div class="sample-block">
      <span class="sample-label">Python, same contract</span>
      <pre><code>{joinPython}</code></pre>
    </div>
  </section>

  <section id="endpoints" class="section">
    <div class="section-heading">
      <h2>Endpoints that stay legible</h2>
      <p>Every path is a static JSON file. There is no authentication, SDK, or request protocol to learn.</p>
    </div>
    <dl class="endpoint-list">
      <dt><code>/manifest.json</code></dt><dd>Counts, script identity, catalogue pointers, and profile licence.</dd>
      <dt><code>/chapters.json</code></dt><dd>Shared metadata for {manifest.chapters.count} chapters.</dd>
      <dt><code>/text/{'{script}'}/chapters/{'{n}'}.json</code></dt><dd>Arabic text, one chapter at a time.</dd>
      <dt><code>/translations/index.json</code></dt><dd>Published translation editions and withheld records.</dd>
      <dt><code>/translations/{'{edition}'}/chapters/{'{n}'}.json</code></dt><dd>Translation text and source footnotes.</dd>
      <dt><code>/transliteration/index.json</code></dt><dd>Romanisation availability and licence status, including an empty answer.</dd>
      <dt><code>/audio/reciters.json</code></dt><dd>Host URL templates; audio itself is never copied here.</dd>
      <dt><code>/meta/sources.json</code></dt><dd>Provenance, source versions, and publishing decisions.</dd>
    </dl>
  </section>

  <section id="scripts" class="section">
    <div class="section-heading">
      <h2>Scripts carry their identity</h2>
      <p>
        A script can describe orthography, a reading, or a numbering system. The manifest says
        which one a consumer is receiving, so joins do not rely on array position.
      </p>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Id</th><th>Name</th><th>Verses</th><th>Verse identity</th><th>Default font</th><th>JSON</th></tr></thead>
        <tbody>
          {manifest.scripts.map((script) => (
            <tr>
              <td><code>{script.id}</code></td>
              <td>{script.name}<br /><span class="muted">{script.description}</span></td>
              <td>{script.verses.toLocaleString()}</td>
              <td><span class="badge">{script.verse_ids}</span>{script.verse_ids_differ_in?.length ? ` · differs in ${script.verse_ids_differ_in.join(", ")}` : ""}</td>
              <td><code>{coverage.scripts[script.id]?.default ?? "—"}</code></td>
              <td><a href={script.path}>quran.json ↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <h3>Mapped readings</h3>
      <p>
        Warsh and Qalun carry their own 6,214 verse count. Each verse has a
        <code>number_in_hafs</code> array; use it as a lookup when pairing a translation keyed
        to the 6,236-verse Hafs count. Indo-Pak chapter 1 declares its own verse identity and
        is kept separate from Hafs translations.
      </p>
      <pre><code>{mappedExample}</code></pre>
    </div>
  </section>

  <section id="catalogues" class="section">
    <div class="section-heading">
      <h2>Generated catalogues</h2>
      <p>
        These rows are rendered from the same JSON files served to clients. Follow an edition to
        its whole Quran or chapter endpoint, then inspect its source and licence record.
      </p>
    </div>

    <div id="translations" class="prose">
      <h3>Translations · {translations.count}</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Language</th><th>Edition</th><th>Direction</th><th>Version</th><th>Status</th><th>Files</th></tr></thead>
          <tbody>
            {translations.editions.map((edition) => (
              <tr>
                <td>{edition.language} <code>{edition.code}</code></td>
                <td><a href={edition.source}>{edition.author}</a></td>
                <td><span class="badge">{edition.direction}</span></td>
                <td>{edition.version ?? "n/a"}</td>
                <td><a href={edition.license.url}>{edition.license.status}</a></td>
                <td><a href={`${edition.path}quran.json`}><code>{editionKey(edition)}</code> ↗</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div id="transliteration" class="prose">
      <h3>Transliteration · {transliterations.count}</h3>
      <p>
        The catalogue is always present. An empty catalogue is an explicit answer when no
        romanisation has a verified grant in the safe default build.
      </p>
      {transliterations.editions.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Edition</th><th>Author</th><th>Status</th><th>Files</th></tr></thead>
            <tbody>
              {transliterations.editions.map((edition) => (
                <tr>
                  <td><code>{editionKey(edition)}</code></td>
                  <td>{edition.author}</td>
                  <td><a href={edition.license.url}>{edition.license.status}</a></td>
                  <td><a href={`${edition.path}quran.json`}>quran.json ↗</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p class="badge">No verified transliteration in this build profile.</p>}
    </div>
  </section>

  <section id="audio" class="section">
    <div class="section-heading">
      <h2>Audio stays a reference</h2>
      <p>Recitations are linked by URL template, so the dataset stays small and hosts retain their files.</p>
    </div>
    <div class="task-grid">
      <article class="task"><span class="number">HOSTS</span><h3>{reciters ? Object.keys(reciters.hosts).length : 0} hosts</h3><p>Each host declares its indexing mode and padding rules in the reciter index.</p><a href="/audio/reciters.json">Open reciter index ↗</a></article>
      <article class="task"><span class="number">REQUESTS</span><h3>Chapter first</h3><p>The reader loads an audio URL only after you choose a reciter and a verse.</p><a href="/app/">Listen in the reader ↗</a></article>
      <article class="task"><span class="number">SOURCES</span><h3>Attribution travels</h3><p>Host and reciter status is recorded beside every generated audio template.</p><a href="/meta/sources.json">Read source records ↗</a></article>
    </div>
  </section>

  <section id="fonts" class="section">
    <div class="section-heading">
      <h2>Fonts are measured at build time</h2>
      <p>
        The reader chooses a bundled font that covers every codepoint a script uses. Coverage is
        a build gate; a missing mark does not become a silent fallback.
      </p>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Script</th><th>Default</th><th>Usable fonts</th></tr></thead>
        <tbody>
          {manifest.scripts.map((script) => (
            <tr><td><code>{script.id}</code></td><td><code>{coverage.scripts[script.id]?.default}</code></td><td>{coverage.scripts[script.id]?.usable.join(", ")}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">For provenance and the measured gaps, see <a href="/app/fonts.json">fonts.json</a> and <a href="/meta/sources.json">source records</a>.</p>
  </section>

  <section id="compatibility" class="section">
    <div class="section-heading">
      <h2>Compatibility is part of the API</h2>
      <p>Public data paths are unversioned because published bytes are not rewritten.</p>
    </div>
    <div class="prose">
      <ul>
        <li>Use <code>id</code> to join verse layers. Use <code>number_in_hafs</code> for mapped readings.</li>
        <li>Translations and transliterations omit Arabic text; load the selected script separately.</li>
        <li>Chapter files avoid whole-corpus downloads. Full <code>quran.json</code> remains available for bulk consumers.</li>
        <li>The frozen npm <code>dist/</code> tree remains a separate compatibility surface.</li>
      </ul>
    </div>
  </section>

  <section id="licensing" class="section">
    <div class="section-heading">
      <h2>Licence status stays visible</h2>
      <p>{profileNote} Read the source manifest before redistributing a layer.</p>
    </div>
    <div class="prose">
      <p>
        The Python publisher is the only catalogue authority. A safe build publishes only
        editions with a recorded grant; the explicit override is a deliberate operator choice
        and keeps its <code>restricted</code> or <code>unknown</code> status in the JSON.
      </p>
      <p><a href="/meta/sources.json">Open provenance and licence records ↗</a></p>
      {translations.withheld.length + transliterations.withheld.length ? (
        <div class="table-wrap">
          <table>
            <thead><tr><th>Withheld edition</th><th>Author</th><th>Status</th><th>Terms</th></tr></thead>
            <tbody>
              {[...translations.withheld, ...transliterations.withheld].map((entry) => (
                <tr><td><code>{entry.edition}</code></td><td>{entry.author}</td><td>{entry.status}</td><td><a href={entry.license_url}>Open terms ↗</a></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : null}
    </div>
  </section>

  <section id="attribution" class="section">
    <div class="section-heading">
      <h2>Source and build notes</h2>
      <p>Generated facts stay next to their data; deeper provenance stays in the machine-readable manifest.</p>
    </div>
    <div class="prose">
      <p>{manifest.attribution}</p>
      <p>
        Build the safe site with <code>npm run site</code>. To publish the explicit rights
        override, pass <code>--include-unverified-licenses</code> to that command and review the
        resulting catalogue before deployment.
      </p>
    </div>
  </section>
</Base>
