---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import { chapterPath, chapterUrl, editionKey, loadCatalog } from "../lib/catalog";

const {
  manifest,
  chapters,
  translations,
  transliterations,
  reciters,
  coverage,
} = loadCatalog();
const firstScript = manifest.scripts[0];
const firstTranslation = translations.editions[0];
const firstChapter = chapters.find((chapter) => chapter.id === 1) ?? chapters[0];
const firstChapterPath = chapterPath(firstTranslation, firstChapter.id);
const firstChapterReaderUrl = `${chapterUrl(firstChapter)}?s=${firstScript.id}`;
const translationLanguages = manifest.translations.languages;
const sortedTranslations = [...translations.editions].sort((a, b) => {
  const left = `${a.language}\u0000${a.author}\u0000${editionKey(a)}`;
  const right = `${b.language}\u0000${b.author}\u0000${editionKey(b)}`;
  return left.localeCompare(right, "en", { sensitivity: "base", numeric: true });
});

const quickstartCurl = `curl -sS https://quran-json.risanb.com/text/${firstScript.id}/chapters/${firstChapter.id}.json`;
const quickstartJavaScript = `const response = await fetch(
  "https://quran-json.risanb.com/text/${firstScript.id}/chapters/${firstChapter.id}.json"
);
const chapter = await response.json();
console.log(chapter.verses);`;
const joinJavaScript = `const arabic = await fetch(
  "https://quran-json.risanb.com/text/${firstScript.id}/chapters/${firstChapter.id}.json"
).then((response) => response.json());
const translated = await fetch(
  "https://quran-json.risanb.com${firstChapterPath}"
).then((response) => response.json());

const translatedById = new Map(
  translated.verses.map((verse) => [verse.id, verse.translation])
);
const rows = arabic.verses.map((verse) => ({
  ...verse,
  translation: translatedById.get(verse.id),
}));`;
const mappedExample = `const duri = await fetch(
  "https://quran-json.risanb.com/text/duri/chapters/2.json"
).then((response) => response.json());

const versesCoveringHafs255 = duri.verses.filter((verse) =>
  verse.number_in_hafs?.includes(255)
);`;
---

<Base
  title="quran-json — Quran data, clearly published"
  description={`Readable Quran text and static JSON with ${manifest.scripts.length} scripts, ${translations.count} translations, and chapter-first endpoints.`}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Quran text + static JSON</p>
      <h1>Al-Quran</h1>
      <p>
        Read a chapter or use a stable JSON path. Arabic editions, translations, and audio
        references stay simple enough to inspect in a browser or a shell.
      </p>
      <div class="actions">
        <a class="button-link primary" href="/app/">Open the reader <span aria-hidden="true">↗</span></a>
        <a class="button-link" href={firstChapterReaderUrl}>Read {firstChapter.transliteration} <span aria-hidden="true">↗</span></a>
        <a class="button-link" href="#quickstart">Fetch one chapter <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-facts" aria-label="Published data counts">
        <span><strong>{manifest.scripts.length}</strong> Arabic editions</span>
        <span><strong>{translations.count}</strong> translations</span>
        <span><strong>{translationLanguages}</strong> languages</span>
        <span><strong>{manifest.chapters.count}</strong> chapters</span>
      </div>
    </div>
  </section>

  <section id="quickstart" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Start here</p>
        <h2>One request, one chapter</h2>
      </div>
      <p>
        Chapter files are ordinary JSON. Copy a complete command or paste the JavaScript into a
        console; no SDK, account, or setup is required.
      </p>
    </div>
    <div class="quickstart-grid">
      <article class="code-card">
        <div class="code-card-heading">
          <div><span class="number">01</span><h3>Try curl</h3></div>
          <button class="copy-button" type="button" data-copy={quickstartCurl} aria-label="Copy the curl chapter example">Copy</button>
        </div>
        <Code code={quickstartCurl} lang="bash" theme="github-dark" />
        <p class="copy-status" data-copy-status aria-live="polite"></p>
        <a class="inline-link" href={`/text/${firstScript.id}/chapters/${firstChapter.id}.json`}>Open the JSON response <span aria-hidden="true">↗</span></a>
      </article>
      <article class="code-card">
        <div class="code-card-heading">
          <div><span class="number">02</span><h3>Use fetch</h3></div>
          <button class="copy-button" type="button" data-copy={quickstartJavaScript} aria-label="Copy the JavaScript chapter example">Copy</button>
        </div>
        <Code code={quickstartJavaScript} lang="javascript" theme="github-dark" />
        <p class="copy-status" data-copy-status aria-live="polite"></p>
      </article>
    </div>
    <noscript><p class="noscript-note">The examples remain selectable without JavaScript.</p></noscript>

    <details class="advanced-detail">
      <summary>Advanced: join a translation by verse id</summary>
      <div class="advanced-content">
        <p>
          Load the two chapter files separately, then join on <code>id</code>. This is optional
          when you only need Arabic text.
        </p>
        <div class="code-card">
          <div class="code-card-heading">
            <h3>JavaScript</h3>
            <button class="copy-button" type="button" data-copy={joinJavaScript} aria-label="Copy the translation join example">Copy</button>
          </div>
          <Code code={joinJavaScript} lang="javascript" theme="github-dark" />
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </div>
      </div>
    </details>
  </section>

  <section id="endpoints" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">The data map</p>
        <h2>Paths that stay legible</h2>
      </div>
      <p>Every endpoint is a static JSON file. Follow a chapter path when you need a small response.</p>
    </div>
    <dl class="endpoint-list">
      <dt><code>/manifest.json</code></dt><dd>Counts, script identity, and catalogue pointers.</dd>
      <dt><code>/chapters.json</code></dt><dd>Shared metadata for {manifest.chapters.count} chapters.</dd>
      <dt><code>/text/{'{script}'}/chapters/{'{n}'}.json</code></dt><dd>Arabic text, one chapter at a time.</dd>
      <dt><code>/translations/index.json</code></dt><dd>Translation editions and their source records.</dd>
      <dt><code>/translations/{'{edition}'}/chapters/{'{n}'}.json</code></dt><dd>Translation text and source footnotes.</dd>
      <dt><code>/transliteration/index.json</code></dt><dd>Romanisation availability, including an empty answer.</dd>
      <dt><code>/audio/reciters.json</code></dt><dd>Host URL templates; audio itself is never copied here.</dd>
      <dt><code>/meta/sources.json</code></dt><dd>Full provenance, rights notes, and withheld records.</dd>
    </dl>
  </section>

  <section id="scripts" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Arabic editions</p>
        <h2>Choose the text first</h2>
      </div>
      <p>
        Names, counts, and verse identity are declared in the manifest. The JSON link in each row
        opens the complete edition.
      </p>
    </div>
    <div class="table-wrap">
      <table class="edition-table">
        <thead><tr><th>Id</th><th>Edition</th><th>Verses</th><th>Identity</th><th>Font</th><th>Data</th></tr></thead>
        <tbody>
          {manifest.scripts.map((script) => (
            <tr>
              <td class="id-cell"><code>{script.id}</code></td>
              <td class="name-cell">
                <strong>{script.name}</strong>
                <span class="secondary">{script.description}</span>
                {script.note ? (
                  <details class="row-details">
                    <summary>Edition notes</summary>
                    <p>{script.note}</p>
                  </details>
                ) : null}
              </td>
              <td class="numeric-cell">{script.verses.toLocaleString()}</td>
              <td><span class="badge">{script.verse_ids}</span>{script.verse_ids_differ_in?.length ? <span class="secondary">differs in {script.verse_ids_differ_in.join(", ")}</span> : null}</td>
              <td class="id-cell"><code>{coverage.scripts[script.id]?.default ?? "—"}</code></td>
              <td class="file-cell"><a href={script.path}>quran.json <span aria-hidden="true">↗</span></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <details class="advanced-detail mapped-detail">
      <summary>Advanced: mapped readings</summary>
      <div class="advanced-content">
        <p>
          Warsh and Qalun each have 6,214 source verses. Duri has 6,218 source verses and maps
          each source verse to Hafs with <code>number_in_hafs</code>; its chapter 1 source
          bismillah is separate furniture, not a numbered verse. Use the declared map instead of
          array position when pairing a mapped reading with Hafs translation data.
        </p>
        <div class="code-card">
          <div class="code-card-heading">
            <h3>Duri · Hafs lookup</h3>
            <button class="copy-button" type="button" data-copy={mappedExample} aria-label="Copy the Duri mapping example">Copy</button>
          </div>
          <Code code={mappedExample} lang="javascript" theme="github-dark" />
          <p class="copy-status" data-copy-status aria-live="polite"></p>
        </div>
      </div>
    </details>
  </section>

  <section id="catalogues" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Translations</p>
        <h2>Find an edition</h2>
      </div>
      <p>Search by language, translator, or id. The complete table remains in the HTML for people without JavaScript.</p>
    </div>

    <div id="translations" class="catalogue-panel" data-translation-table>
      <div class="catalogue-toolbar">
        <div class="search-field">
          <label for="translation-search">Search translations</label>
          <input id="translation-search" type="search" autocomplete="off" placeholder="Language, name, or id" aria-controls="translation-table" />
        </div>
        <button class="button-link clear-button" type="button" data-translation-clear hidden>Clear</button>
        <p class="catalogue-count" data-translation-count aria-live="polite">{translations.count} translations</p>
      </div>
      <noscript><p class="noscript-note">All {translations.count} translations are shown below. Search and paging are optional enhancements.</p></noscript>
      <div class="table-wrap">
        <table id="translation-table" class="translation-table">
          <thead><tr><th>Language</th><th>Edition</th><th>Data</th></tr></thead>
          <tbody>
            {sortedTranslations.map((edition) => (
              <tr data-translation-row data-search={`${edition.language} ${edition.code} ${edition.author} ${edition.edition} ${editionKey(edition)}`.toLowerCase()}>
                <td class="language-cell" data-label="Language"><span>{edition.language}</span> <code>{edition.code}</code></td>
                <td class="name-cell" data-label="Edition">
                  <strong>{edition.author}</strong>
                  <details class="row-details">
                    <summary>Edition details</summary>
                    <p>
                      {edition.direction ?? "unknown"} · {edition.version ?? "version not listed"} ·
                      <a href={edition.source}>source</a> ·
                      <a href={edition.license.url}>licence ({edition.license.status})</a>
                    </p>
                  </details>
                </td>
                <td class="file-cell" data-label="Data"><a href={`${edition.path}quran.json`}><code>{editionKey(edition)}</code> <span aria-hidden="true">↗</span></a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="empty-state" data-translation-empty hidden>No translations match that search. <button type="button" class="inline-button" data-translation-reset>Clear search</button></p>
      <nav class="catalogue-pagination" data-translation-pagination aria-label="Translation pages">
        <button type="button" class="button-link" data-translation-previous>Previous</button>
        <span data-translation-page aria-live="polite"></span>
        <button type="button" class="button-link" data-translation-next>Next</button>
      </nav>
    </div>

    <div id="transliteration" class="catalogue-summary">
      <h3>Transliteration · {transliterations.count}</h3>
      <p>
        No transliteration is published in the safe catalogue. The empty answer and withheld
        candidate records remain available in <a href="/transliteration/index.json">the catalogue JSON</a>.
      </p>
    </div>
  </section>

  <section id="audio" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Audio references</p>
        <h2>Audio stays a reference</h2>
      </div>
      <p>Recitations remain linked by URL template, so the dataset stays small and hosts retain their files.</p>
    </div>
    <div class="task-grid">
      <article class="task"><span class="number">HOSTS</span><h3>{reciters ? Object.keys(reciters.hosts).length : 0} hosts</h3><p>Each host declares its indexing mode and padding rules in the reciter index.</p><a href="/audio/reciters.json">Open reciter index ↗</a></article>
      <article class="task"><span class="number">REQUESTS</span><h3>Chapter first</h3><p>The reader loads an audio URL only after you choose a reciter and a verse.</p><a href="/app/">Listen in the reader ↗</a></article>
      <article class="task"><span class="number">SOURCES</span><h3>Attribution travels</h3><p>Host and reciter source records stay beside every public template.</p><a href="/meta/sources.json">Read source records ↗</a></article>
    </div>
  </section>

  <section id="fonts" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Typography</p>
        <h2>Font coverage</h2>
      </div>
      <p>The reader chooses a bundled font that covers every codepoint used by an edition.</p>
    </div>
    <div class="table-wrap">
      <table class="font-table">
        <thead><tr><th>Script</th><th>Default</th><th>Usable fonts</th></tr></thead>
        <tbody>
          {manifest.scripts.map((script) => (
            <tr><td class="id-cell"><code>{script.id}</code></td><td class="id-cell"><code>{coverage.scripts[script.id]?.default}</code></td><td>{coverage.scripts[script.id]?.usable.join(", ")}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted">For measured coverage and source notes, see <a href="/app/fonts.json">fonts.json</a>.</p>
  </section>

  <section id="sources" class="section">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Sources</p>
        <h2>Read the source record</h2>
      </div>
      <p>Every edition links to its source and licence. Full provenance, rights notes, and withheld records remain in the machine-readable JSON.</p>
    </div>
    <div class="source-links">
      <a class="button-link primary" href="/meta/sources.json">Open sources and licences <span aria-hidden="true">↗</span></a>
      <a class="button-link" href="/manifest.json">Open manifest <span aria-hidden="true">↗</span></a>
      <a class="button-link" href="/translations/index.json">Open translation catalogue <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script is:inline>
    (() => {
      document.documentElement.classList.add("js");

      const copy = async (text) => {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(text);
      };

      const showSelectionFallback = (button, text, status) => {
        const card = button.closest(".code-card");
        if (!card) return;
        let selection = card.querySelector(".copy-fallback");
        if (!selection) {
          selection = document.createElement("textarea");
          selection.className = "copy-fallback";
          selection.readOnly = true;
          selection.setAttribute("aria-label", "Code selected for copying");
          card.append(selection);
        }
        selection.value = text;
        selection.hidden = false;
        selection.focus();
        selection.select();
        if (status) status.textContent = "Clipboard unavailable. Code selected. Press Ctrl+C or ⌘C to copy.";
      };

      for (const button of document.querySelectorAll("[data-copy]")) {
        const originalLabel = button.textContent;
        const status = button.closest(".code-card")?.querySelector("[data-copy-status]");
        button.addEventListener("click", async () => {
          try {
            await copy(button.getAttribute("data-copy") ?? "");
            button.textContent = "Copied";
            if (status) status.textContent = "Copied to clipboard.";
            button.closest(".code-card")?.querySelector(".copy-fallback")?.setAttribute("hidden", "");
          } catch {
            button.textContent = "Copy failed";
            showSelectionFallback(button, button.getAttribute("data-copy") ?? "", status);
          }
          window.setTimeout(() => {
            button.textContent = originalLabel;
            if (status) status.textContent = "";
          }, 2400);
        });
      }

      const panel = document.querySelector("[data-translation-table]");
      if (!panel) return;
      const rows = [...panel.querySelectorAll("[data-translation-row]")];
      const search = panel.querySelector("#translation-search");
      const clear = panel.querySelector("[data-translation-clear]");
      const count = panel.querySelector("[data-translation-count]");
      const empty = panel.querySelector("[data-translation-empty]");
      const reset = panel.querySelector("[data-translation-reset]");
      const pageStatus = panel.querySelector("[data-translation-page]");
      const previous = panel.querySelector("[data-translation-previous]");
      const next = panel.querySelector("[data-translation-next]");
      const pageSize = 12;
      let page = 1;

      const render = () => {
        const term = (search?.value ?? "").trim().toLowerCase();
        const matches = rows.filter((row) => (row.getAttribute("data-search") ?? "").includes(term));
        const pages = Math.max(1, Math.ceil(matches.length / pageSize));
        page = Math.min(page, pages);
        const start = (page - 1) * pageSize;
        const visible = new Set(matches.slice(start, start + pageSize));
        rows.forEach((row) => { row.hidden = !visible.has(row); });
        if (count) count.textContent = matches.length ? `Showing ${start + 1}–${Math.min(start + pageSize, matches.length)} of ${matches.length} translations` : "0 translations";
        if (empty) empty.hidden = matches.length !== 0;
        if (pageStatus) pageStatus.textContent = matches.length ? `Page ${page} of ${pages}` : "No pages";
        if (previous) previous.disabled = page <= 1 || matches.length === 0;
        if (next) next.disabled = page >= pages || matches.length === 0;
        if (clear) clear.hidden = term.length === 0;
      };

      search?.addEventListener("input", () => { page = 1; render(); });
      clear?.addEventListener("click", () => { if (search) search.value = ""; page = 1; search?.focus(); render(); });
      reset?.addEventListener("click", () => { if (search) search.value = ""; page = 1; search?.focus(); render(); });
      previous?.addEventListener("click", () => { page -= 1; render(); });
      next?.addEventListener("click", () => { page += 1; render(); });
      render();
    })();
  </script>
</Base>
