---
import type { ComponentProps } from "astro/types";
import { Menu, X } from "lucide-react";
import Base from "../layouts/Base.astro";
import CodeTabs from "../components/docs/CodeTabs.astro";
import Section from "../components/docs/Section.astro";
import Toc from "../components/docs/Toc.astro";
import { buttonVariants } from "../components/ui/button";
import {
  count,
  editionKey,
  loadCatalog,
  groupScripts,
  readingLabel,
  sortEditions,
  transliterationSample,
  verseIdsLabel,
} from "../lib/catalog";

const { manifest, translations, transliterations, reciters, coverage, sources } = loadCatalog();

const origin = "https://quran-json.risanb.com";
const scriptGroups = groupScripts(manifest.scripts);
const scripts = scriptGroups.flatMap((group) => group.scripts);
const scriptIds = new Set(scripts.map((script) => script.id));
const editions = sortEditions(translations.editions);
const english = editions.find((edition) => edition.code === "en") ?? editions[0];

const quickstart: ComponentProps<typeof CodeTabs>["tabs"] = [
  {
    label: "curl",
    lang: "bash",
    code: `curl -s ${origin}/text/uthmani/chapters/1.json
curl -s ${origin}${english.path}chapters/1.json`,
  },
  {
    label: "JavaScript",
    lang: "javascript",
    code: `const get = (path) => fetch("${origin}" + path).then((r) => r.json());

const arabic = await get("/text/uthmani/chapters/1.json");
const english = await get("${english.path}chapters/1.json");

// Both files number verses from 1: join on \`id\`.
const verses = arabic.verses.map((verse, i) => ({
  ...verse,
  translation: english.verses[i].translation,
}));`,
  },
  {
    label: "Python",
    lang: "python",
    code: `import requests

def get(path):
    return requests.get("${origin}" + path, timeout=30).json()

arabic = get("/text/uthmani/chapters/1.json")
english = get("${english.path}chapters/1.json")

# Both files number verses from 1: join on \`id\`.
for verse, tr in zip(arabic["verses"], english["verses"]):
    print(verse["id"], verse["text"], tr["translation"])`,
  },
];

const endpoints: [string, string][] = [
  ["/manifest.json", "Scripts, counts, project licence and attribution."],
  [
    "/chapters.json",
    "The 114 chapters: Arabic name, transliterated name, meaning, type, verse count.",
  ],
  ["/text/{script}/quran.json", "Every chapter of one script, as an array."],
  ["/text/{script}/chapters/{1-114}.json", "One chapter: { id, verses: [{ id, text }] }."],
  [
    "/translations/index.json",
    "Every translation edition: language, translator, version, licence.",
  ],
  [
    "/translations/{code}-{slug}/quran.json",
    "One edition, all chapters. Verses carry translation and, where the publisher gives one, footnotes.",
  ],
  ["/translations/{code}-{slug}/chapters/{1-114}.json", "One edition, one chapter."],
  ["/transliteration/index.json", "Transliteration editions (see below)."],
  ["/transliteration/{key}/quran.json", "One transliteration, all chapters."],
  ["/transliteration/{key}/chapters/{1-114}.json", "One transliteration, one chapter."],
  ["/audio/reciters.json", "Reciters, hosts and URL templates. Audio is linked, not hosted."],
  ["/meta/sources.json", "Source, licence and snapshot hash of every dataset."],
  ["/meta/qa.json", "Corrections applied to upstream text, with evidence."],
];

const guide: { use: string; ids: string[]; text: string }[] = [
  { use: "Most apps", ids: ["uthmani"], text: "Madinah mushaf style, Hafs reading." },
  {
    use: "KFGQPC fonts",
    ids: ["qpc-hafs"],
    text: "KFGQPC encoding, for KFGQPC fonts.",
  },
  { use: "Search and matching", ids: ["simple-clean"], text: "No vowel marks." },
  {
    use: "South Asia",
    ids: ["hafs-nastaliq", "indopak"],
    text: "Nastaliq (KFGQPC) or Indo-Pak naskh (DigitalKhatt).",
  },
  { use: "Indonesia", ids: ["kemenag"], text: "Mushaf Standar Indonesia." },
  { use: "North and West Africa", ids: ["warsh", "qalun"], text: "Readings of Nafi." },
  { use: "Sudan", ids: ["duri"], text: "al-Duri, reading of Abu Amr." },
];

const languages = [
  ...new Map(editions.map((edition) => [edition.language ?? "", edition.code ?? ""])).entries(),
].sort(([a], [b]) => a.localeCompare(b));

const published = transliterations.editions;

const hosts = reciters
  ? Object.entries(reciters.hosts).map(([id, host]) => {
      const entries = reciters.reciters.filter((reciter) => reciter.host === id);

      return {
        id,
        host,
        reciters: entries.length,
        scope: [...new Set(entries.map((reciter) => reciter.scope))]
          .map((scope) => (scope === "ayah" ? "per ayah" : "per surah"))
          .join(", "),
      };
    })
  : [];

const isPublicDomain = (edition: (typeof editions)[number]) =>
  /^public domain/i.test(edition.license?.text ?? "");
const publicDomain = editions.filter(isPublicDomain);
const quranEnc = editions.filter((edition) => (edition.source ?? "").includes("quranenc.com"));
const clearQuran = editions.filter((edition) =>
  (edition.license?.url ?? "").includes("clearquran"),
);
const grouped = new Set([...publicDomain, ...quranEnc, ...clearQuran]);
const otherEditions = editions.filter((edition) => !grouped.has(edition));

function publicDomainLabel(edition: (typeof editions)[number]): string {
  const name = edition.author.replace(/\s*\(\d{4}\)\s*$/, "");
  const died = edition.license?.text?.match(/died (\d{4})/)?.[1];

  return died ? `${name} (d. ${died})` : name;
}

// The Arabic text rows: one per source, whichever scripts it supplies.
const textSources = [
  {
    match: "tanzil.net",
    name: "Tanzil",
    terms:
      "CC BY 3.0, verbatim. Tanzil texts may not be changed and carry Tanzil's notice in every chapter file.",
  },
  {
    match: "quranpedia",
    name: "Qur'anpedia.net (KFGQPC and qira'at texts)",
    terms:
      "Credit Qur'anpedia.net and state the dump version, which /meta/sources.json records per snapshot.",
  },
  {
    match: "kemenag",
    name: "Kemenag (LPMQ)",
    terms:
      "The mushaf text is not copyrightable under PMA 44/2016 Pasal 8(1). Plain text only: no fonts or layout.",
  },
  { match: "digitalkhatt", name: "DigitalKhatt", terms: "MIT licence." },
];
const scriptLicences = sources.text.script_licenses ?? [];
const textRows = textSources
  .map((source) => {
    const members = scriptLicences.filter((entry) =>
      (entry.license_url ?? "").includes(source.match),
    );

    return {
      ...source,
      ids: members.map((entry) => entry.script),
      url: members[0]?.license_url,
    };
  })
  .filter((row) => row.ids.length > 0);
const knownIds = new Set(textRows.flatMap((row) => row.ids));
const otherTextIds = scripts.map((script) => script.id).filter((id) => !knownIds.has(id));
const fontLicences = [...new Set(coverage.fonts.map((font) => font.license))];

const notUsed = [...sources.withheld];
const notUsedSources = [
  ["Tanzil translations and transliteration", "non-commercial use only, no redistribution."],
  ["Quran.com API", "personal, non-commercial terms."],
  [
    "Saheeh International via Tanzil",
    "all rights reserved. The Saheeh edition QuranEnc grants is published.",
  ],
  ["QuranWBW and Quran.com Indo-Pak text", "the notice forbids distribution."],
  [
    "KFGQPC direct downloads",
    "all rights reserved. We use Quranpedia's grant for the KFGQPC-based texts instead.",
  ],
  ["Diyanet Turkish text", "the Presidency refuses redistribution."],
  [
    "Kemenag 2019 translation and Latin romanisation",
    "no grant. Our transliterations are generated instead.",
  ],
  ["fawazahmed0 quran-api", "no licence per edition."],
  ["QUL and Tarteel resources", "no licence stated."],
  [
    "Quranpedia al-Bazzi and Qunbul",
    "granted, but the verse map is broken in Al-Jinn, so they are not published yet.",
  ],
] as const;

const toc = [
  { id: "quick-start", label: "Quick start" },
  { id: "endpoints", label: "Endpoints" },
  { id: "scripts", label: "Scripts" },
  { id: "translations", label: "Translations" },
  { id: "transliteration", label: "Transliteration" },
  { id: "audio", label: "Audio" },
  { id: "sources", label: "Sources and licences" },
  { id: "changes", label: "Changes" },
];

const stats = [
  [manifest.scripts.length, "scripts"],
  [translations.count, "translations"],
  [manifest.translations.languages, "languages"],
  [manifest.transliteration.count, "transliterations"],
] as const;
---

<Base
  current="docs"
  title="quran-json: Quran text, translations and audio links as static JSON"
  description={`Quran text in ${manifest.scripts.length} scripts and ${translations.count} translations as static JSON files. No key, no server.`}
>
  <div class="bg-background sticky top-12 z-30 flex h-10 items-center border-b px-4 lg:hidden">
    <button
      type="button"
      data-toc-open
      class={buttonVariants({ variant: "ghost", size: "sm" }) + " -ml-2.5"}
    >
      <Menu className="size-4" aria-hidden="true" />
      <span class="text-muted-foreground">On this page</span>
      <span data-toc-current>Quick start</span>
    </button>
  </div>

  <dialog
    data-toc-dialog
    aria-label="On this page"
    class="bg-background text-foreground m-0 mr-auto h-dvh max-h-none w-64 max-w-[85vw] border-r p-3 backdrop:bg-black/40"
  >
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold">On this page</span>
      <button
        type="button"
        data-toc-close
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
        aria-label="Close"
      >
        <X className="size-4" aria-hidden="true" />
      </button>
    </div>
    <Toc items={toc} />
  </dialog>

  <div class="mx-auto max-w-[1120px] px-4 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-10">
    <aside class="sticky top-12 hidden h-[calc(100dvh-3rem)] self-start overflow-y-auto py-6 lg:block">
      <Toc items={toc} />
    </aside>

    <main class="min-w-0 max-w-[860px] space-y-8 py-6">
      <div class="space-y-3">
        <h1 class="text-xl font-semibold">Quran JSON</h1>
        <p class="doc-prose">
          The Quran as static JSON files: Arabic text in {manifest.scripts.length} scripts,{" "}
          {translations.count} translations, and links to recitations. No key, no server; fetch a
          file.
        </p>
        <dl class="text-muted-foreground flex flex-wrap gap-x-5 gap-y-1 text-[13px]">
          {stats.map(([value, label]) => (
            <div class="flex gap-1">
              <dt class="text-foreground font-medium">{value}</dt>
              <dd>{label}</dd>
            </div>
          ))}
        </dl>
        <div class="flex gap-2">
          <a href="/app/" class={buttonVariants({ size: "sm" })}>
            Open reader
          </a>
          <a
            href="https://github.com/risan/quran-json"
            class={buttonVariants({ variant: "outline", size: "sm" })}
          >
            GitHub
          </a>
        </div>
      </div>

      <Section id="quick-start" title="Quick start">
        <p class="doc-prose">
          Fetch a chapter of Arabic text and a translation, then join them on verse <code>id</code>.
        </p>
        <CodeTabs label="Fetch chapter 1" tabs={quickstart} />
      </Section>

      <Section id="endpoints" title="Endpoints">
        <p class="doc-prose">
          All files are JSON, served from <code>{origin}</code>, with CORS open to any origin.
        </p>
        <div class="overflow-x-auto rounded-md border">
          <table class="doc-table">
            <thead>
              <tr>
                <th scope="col">Path</th>
                <th scope="col">Returns</th>
              </tr>
            </thead>
            <tbody>
              {endpoints.map(([path, description]) => (
                <tr>
                  <td class="whitespace-nowrap">
                    <code>{path}</code>
                  </td>
                  <td class="text-muted-foreground">{description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Section>

      <Section id="scripts" title="Scripts">
        <p class="doc-prose">Which script should I use?</p>
        <ul class="space-y-1 text-[13px]">
          {guide
            .filter((entry) => entry.ids.some((id) => scriptIds.has(id)))
            .map((entry) => (
              <li class="grid grid-cols-[9.5rem_minmax(0,1fr)] gap-x-3 max-sm:block">
                <span class="font-medium">{entry.use}</span>
                <span class="text-muted-foreground">
                  {entry.ids
                    .filter((id) => scriptIds.has(id))
                    .map((id, index) => (
                      <>
                        {index > 0 ? " or " : ""}
                        <code class="bg-muted rounded px-1 py-0.5 text-[12px]">{id}</code>
                      </>
                    ))}
                  . {entry.text}
                </span>
              </li>
            ))}
        </ul>
        <p class="doc-prose">
          Page layouts such as the 13-, 15- and 16-line mushafs are not texts. Every script here is
          text; line breaks are yours to choose.
        </p>
        <div class="overflow-x-auto rounded-md border">
          <table class="doc-table">
            <thead>
              <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Reading</th>
                <th scope="col">Verses</th>
                <th scope="col">Verse ids</th>
                <th scope="col">File</th>
              </tr>
            </thead>
            <tbody>
              {scriptGroups.map((group) => (
                <>
                  <tr>
                    <th scope="colgroup" colspan="6" class="bg-muted/50 text-[12px] font-semibold">
                      {group.title}
                    </th>
                  </tr>
                  {group.scripts.map((script) => (
                    <tr>
                      <td>
                        <code>{script.id}</code>
                      </td>
                      <td>{script.name}</td>
                      <td>{readingLabel(script)}</td>
                      <td>{count(script.verses)}</td>
                      <td class="text-muted-foreground">
                        {verseIdsLabel(script).replaceAll("`", "")}
                      </td>
                      <td class="whitespace-nowrap">
                        <a href={script.path} class="link">
                          quran.json
                        </a>
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
        <p class="doc-prose">
          Translations are numbered like Hafs. Warsh, Qalun and al-Duri number verses their own way,
          so each of their verses carries <code>number_in_hafs</code>, the Hafs verse number or
          numbers it covers.
        </p>
      </Section>

      <Section id="translations" title="Translations">
        <div data-translations class="space-y-2">
          <div hidden data-translation-controls class="flex flex-wrap items-center gap-2">
            <label class="sr-only" for="translation-search">
              Search translations
            </label>
            <input
              id="translation-search"
              type="search"
              data-translation-search
              placeholder="Search by language, translator or path"
              class="border-input bg-background placeholder:text-muted-foreground focus-visible:ring-ring h-8 min-w-0 flex-1 rounded-md border px-2.5 text-sm outline-none focus-visible:ring-2 sm:max-w-xs"
            />
            <label class="sr-only" for="translation-language">
              Language
            </label>
            <select
              id="translation-language"
              data-translation-language
              class="border-input bg-background focus-visible:ring-ring h-8 rounded-md border px-2 text-sm outline-none focus-visible:ring-2"
            >
              <option value="">All languages</option>
              {languages.map(([language]) => (
                <option value={language} class="capitalize">
                  {language}
                </option>
              ))}
            </select>
            <span
              class="text-muted-foreground text-[13px]"
              data-translation-count
              role="status"
            ></span>
          </div>
          <div class="max-h-[28rem] overflow-auto rounded-md border">
            <table class="doc-table">
              <thead class="bg-background sticky top-0">
                <tr>
                  <th scope="col">Language</th>
                  <th scope="col">Translator</th>
                  <th scope="col">Version</th>
                  <th scope="col">Path</th>
                </tr>
              </thead>
              <tbody>
                {editions.map((edition) => (
                  <tr
                    data-translation-row
                    data-language={edition.language}
                    data-search={`${edition.language} ${edition.code} ${edition.author} ${edition.path}`.toLowerCase()}
                  >
                    <td class="whitespace-nowrap capitalize">
                      {edition.language} <span class="text-muted-foreground">{edition.code}</span>
                    </td>
                    <td>{edition.author}</td>
                    <td class="text-muted-foreground">{edition.version ?? ""}</td>
                    <td class="whitespace-nowrap">
                      <a href={`${edition.path}quran.json`} class="link">
                        <code>{edition.path}</code>
                      </a>
                    </td>
                  </tr>
                ))}
                <tr data-translation-empty hidden>
                  <td colspan="4" class="text-muted-foreground">
                    No translation matches.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </Section>

      <Section id="transliteration" title="Transliteration">
        {published.length === 0 ? (
          <p class="doc-prose">None published yet.</p>
        ) : (
          <>
            <p class="doc-prose">
              {published.length} Latin-script renderings of the Hafs text. They follow the Hafs
              reading and numbering, so they are not offered for Warsh, Qalun or al-Duri.
            </p>
            <div class="overflow-x-auto rounded-md border">
              <table class="doc-table">
                <thead>
                  <tr>
                    <th scope="col">Key</th>
                    <th scope="col">Name</th>
                    <th scope="col">Sample, 1:1</th>
                    <th scope="col">Path</th>
                  </tr>
                </thead>
                <tbody>
                  {published.map((edition) => (
                    <tr>
                      <td>
                        <code>{editionKey(edition)}</code>
                      </td>
                      <td>{edition.name ?? edition.author}</td>
                      <td>{transliterationSample(edition)}</td>
                      <td class="whitespace-nowrap">
                        <a href={`${edition.path}quran.json`} class="link">
                          <code>{edition.path}</code>
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {[...new Set(published.map((edition) => edition.review).filter(Boolean))].map(
              (review) => (
                <p class="text-muted-foreground text-[13px]">{review}</p>
              ),
            )}
          </>
        )}
      </Section>

      <Section id="audio" title="Audio">
        {reciters ? (
          <>
            <p class="doc-prose">
              Audio is linked, not hosted. <code>/audio/reciters.json</code> lists{" "}
              {count(reciters.reciters.length)} recordings with URL templates. Per-ayah files follow
              Hafs verse numbering, so they only fit Hafs scripts. Per-surah files play one whole
              chapter and need a recording of the same reading as the script.
            </p>
            <div class="overflow-x-auto rounded-md border">
              <table class="doc-table">
                <thead>
                  <tr>
                    <th scope="col">Host</th>
                    <th scope="col">Files</th>
                    <th scope="col">Recordings</th>
                    <th scope="col">Licence</th>
                  </tr>
                </thead>
                <tbody>
                  {hosts.map((entry) => (
                    <tr>
                      <td>
                        <a href={entry.host.home} class="link">
                          {entry.host.name}
                        </a>
                      </td>
                      <td>{entry.scope}</td>
                      <td>{count(entry.reciters)}</td>
                      <td>
                        {entry.host.license_url ? (
                          <a href={entry.host.license_url} class="link">
                            {entry.host.license_status}
                          </a>
                        ) : (
                          entry.host.license_status
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="doc-prose">This build has no audio index.</p>
        )}
      </Section>

      <Section id="sources" title="Sources and licences">
        <p class="doc-prose">
          Dataset licence: {manifest.license.project}. Each source keeps its own terms. Detail per
          file is in{" "}
          <a href="/meta/sources.json" class="link">
            /meta/sources.json
          </a>
          .
        </p>
        <div class="overflow-x-auto rounded-md border">
          <table class="doc-table">
            <thead>
              <tr>
                <th scope="col">Data</th>
                <th scope="col">Terms</th>
                <th scope="col">Licence</th>
              </tr>
            </thead>
            <tbody>
              {textRows.map((row) => (
                <tr>
                  <td>
                    Arabic: {row.name}
                    <span class="text-muted-foreground block text-xs">{row.ids.join(", ")}</span>
                  </td>
                  <td class="text-muted-foreground max-w-[28rem]">{row.terms}</td>
                  <td>
                    {row.url ? (
                      <a href={row.url} class="link">
                        terms
                      </a>
                    ) : null}
                  </td>
                </tr>
              ))}
              {textRows.length === 0 || otherTextIds.length > 0 ? (
                <tr>
                  <td>
                    Arabic text
                    {textRows.length > 0 && (
                      <span class="text-muted-foreground block text-xs">
                        {otherTextIds.join(", ")}
                      </span>
                    )}
                  </td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    {manifest.license.text.source}
                  </td>
                  <td>
                    <a href={manifest.license.text.url} class="link">
                      terms
                    </a>
                  </td>
                </tr>
              ) : null}
              {publicDomain.length > 0 && (
                <tr>
                  <td>Public-domain translations ({publicDomain.length})</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    {publicDomain.map(publicDomainLabel).join("; ")}.
                  </td>
                  <td>public domain</td>
                </tr>
              )}
              {quranEnc.length > 0 && (
                <tr>
                  <td>QuranEnc ({quranEnc.length} editions)</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    Republishing is allowed unmodified, with the publisher and QuranEnc.com credited
                    and the version stated.
                  </td>
                  <td>
                    <a href={quranEnc[0].license?.url} class="link">
                      terms
                    </a>
                  </td>
                </tr>
              )}
              {clearQuran.length > 0 && (
                <tr>
                  <td>ClearQuran ({clearQuran.length})</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    Talal Itani. Keep the files unmodified and credit "Translation by Talal Itani,
                    ClearQuran.com".
                  </td>
                  <td>
                    <a href={clearQuran[0].license?.url} class="link">
                      CC BY-ND 4.0
                    </a>
                  </td>
                </tr>
              )}
              {otherEditions.length > 0 && (
                <tr>
                  <td>Other translations ({otherEditions.length})</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    {otherEditions.map((edition) => edition.author).join("; ")}.
                  </td>
                  <td>see /translations/index.json</td>
                </tr>
              )}
              {published.length > 0 && (
                <tr>
                  <td>Transliterations ({published.length})</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    Generated by this project from the Hafs text.
                  </td>
                  <td>{manifest.license.project}</td>
                </tr>
              )}
              {hosts.map((entry) => (
                <tr>
                  <td>Audio: {entry.host.name}</td>
                  <td class="text-muted-foreground max-w-[28rem]">
                    Linked, not copied. Status: {entry.host.license_status}.
                  </td>
                  <td>
                    {entry.host.license_url ? (
                      <a href={entry.host.license_url} class="link">
                        terms
                      </a>
                    ) : null}
                  </td>
                </tr>
              ))}
              <tr>
                <td>Fonts ({coverage.fonts.length})</td>
                <td class="text-muted-foreground max-w-[28rem]">
                  {coverage.fonts.map((font, index) => (
                    <>
                      {index > 0 ? ", " : ""}
                      <a href={font.license_file} class="link">
                        {font.name}
                      </a>
                    </>
                  ))}
                  .
                </td>
                <td>{fontLicences.join(", ")}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <details class="text-[13px]">
          <summary class="cursor-pointer font-medium">
            Sources we checked and do not use ({notUsedSources.length})
          </summary>
          <ul class="text-muted-foreground mt-2 list-disc space-y-1 pl-5">
            {notUsedSources.map(([name, reason]) => (
              <li>
                {name}: {reason}
              </li>
            ))}
          </ul>
        </details>
        {notUsed.length > 0 && (
          <details class="text-[13px]">
            <summary class="cursor-pointer font-medium">
              QuranEnc editions we do not publish because they are incomplete ({notUsed.length})
            </summary>
            <ul class="text-muted-foreground mt-2 list-disc space-y-1 pl-5">
              {notUsed.map((item) => (
                <li>
                  {item.author}: {item.reason ?? "no redistribution grant"}
                </li>
              ))}
            </ul>
          </details>
        )}
      </Section>

      <Section id="changes" title="Changes">
        <ul class="doc-prose text-muted-foreground list-disc space-y-1 pl-5 text-sm leading-6">
          <li>A published path is never renamed or removed.</li>
          <li>
            Content can be corrected when an upstream source corrects it. Text corrections are
            logged with evidence in{" "}
            <a href="/meta/qa.json" class="link">
              /meta/qa.json
            </a>
            ; source versions are in
            <a href="/meta/sources.json" class="link">
              /meta/sources.json
            </a>
            . Do not assume the bytes at a URL never change.
          </li>
          <li>
            Removed in this release: <code>/app/fonts.json</code>, <code>/assets/*</code> (fonts
            moved to
            <code>/fonts/*</code>) and <code>/app/*.js|css</code>. They only served the old pages.
          </li>
          <li>
            The old <code>dist/</code> files stay available from npm <code>quran-json@3.1.2</code>{" "}
            and the
            <code>v3.1.2</code> git tag.
          </li>
        </ul>
      </Section>
    </main>
  </div>

  <script>
    import "../scripts/docs";
  </script>
</Base>
