---
import { Monitor, Moon, Sun } from "lucide-react";
import { buttonVariants } from "./ui/button";

interface Props {
  current: "docs" | "reader";
}

const { current } = Astro.props;
const links = [
  { id: "docs", label: "Docs", href: "/" },
  { id: "reader", label: "Reader", href: "/app/" },
] as const;
---

<header class="bg-background sticky top-0 z-40 h-12 border-b">
  <div class="flex h-full items-center gap-4 px-4">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight text-foreground no-underline">
      quran-json
    </a>
    <nav aria-label="Main" class="flex items-center gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.id === current ? "page" : undefined}
          class="text-muted-foreground hover:text-foreground aria-[current=page]:text-brand rounded-md px-2 py-1 text-[13px] font-medium no-underline aria-[current=page]:font-semibold"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a
        href="https://github.com/risan/quran-json"
        aria-label="quran-json on GitHub"
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
      </a>
      <button
        type="button"
        data-theme-toggle
        class={buttonVariants({ variant: "ghost", size: "icon-sm" })}
        aria-label="Theme"
        title="Theme"
      >
        <Sun className="theme-icon theme-icon-light" aria-hidden="true" />
        <Moon className="theme-icon theme-icon-dark" aria-hidden="true" />
        <Monitor className="theme-icon theme-icon-system" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  const KEY = "quran-json:theme";
  const modes = ["light", "dark", "system"] as const;
  type Mode = (typeof modes)[number];

  function currentMode(): Mode {
    const mode = document.documentElement.dataset.theme;

    return modes.find((candidate) => candidate === mode) ?? "system";
  }

  function apply(mode: Mode) {
    const dark =
      mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches);

    document.documentElement.classList.toggle("dark", dark);
    document.documentElement.dataset.theme = mode;
    document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
      const next = modes[(modes.indexOf(mode) + 1) % modes.length];
      const label = `Theme: ${mode}. Switch to ${next}.`;

      button.setAttribute("aria-label", label);
      button.title = label;
    });
  }

  apply(currentMode());

  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const next = modes[(modes.indexOf(currentMode()) + 1) % modes.length];

      try {
        if (next === "system") {
          localStorage.removeItem(KEY);
        } else {
          localStorage.setItem(KEY, next);
        }
      } catch {
        // Private mode: the choice just lasts for this page view.
      }

      apply(next);
    });
  });

  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (currentMode() === "system") {
      apply("system");
    }
  });
</script>
