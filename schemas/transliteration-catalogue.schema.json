{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/risan/quran-json/main/schemas/transliteration-catalogue.schema.json",
  "title": "quran-json transliteration catalogue",
  "description": "The discovery index at /transliteration/index.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["count", "editions", "withheld"],
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "editions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edition"
      }
    },
    "withheld": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/withheld"
      }
    }
  },
  "$defs": {
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "edition",
        "author",
        "source",
        "license",
        "chapters",
        "files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/transliteration/[a-z0-9-]+/$"
        },
        "edition": {
          "type": "string",
          "pattern": "^transliteration_[a-z0-9-]+$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "chapters": {
          "const": 114
        },
        "files": {
          "$ref": "#/$defs/files"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quran", "chapters"],
      "properties": {
        "quran": {
          "type": "string",
          "pattern": "^/transliteration/[a-z0-9-]+/quran\\.json$"
        },
        "chapters": {
          "type": "string",
          "pattern": "^/transliteration/[a-z0-9-]+/chapters/\\{1-114\\}\\.json$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "url"],
      "properties": {
        "status": {
          "enum": ["granted", "restricted", "unknown"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      }
    },
    "withheld": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "author", "status", "license_url"],
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["granted", "restricted", "unknown"]
        },
        "license_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      }
    }
  }
}
