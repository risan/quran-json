{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/risan/quran-json/main/schemas/script.schema.json",
  "title": "quran-json Arabic script",
  "description": "A complete script quran.json array or one chapter file's equivalent items.",
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    {
      "$ref": "#/$defs/chapter"
    }
  ],
  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verses"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 114
        },
        "verses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verse"
          }
        }
      }
    },
    "verse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "number_in_hafs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
